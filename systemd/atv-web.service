[Unit]
Description=Apple TV Web Remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kais/atv-web
ExecStart=/home/kais/atv-web/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8083
Restart=always
RestartSec=5
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

[Install]
WantedBy=default.target
